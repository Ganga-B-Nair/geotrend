data/raw/_fixture.csv

# Derived artefacts are regenerable from the notebooks.
data/processed/*.parquet
data/external/*.json
models/*.pkl
!models/.gitkeep

# BUT keep the overlay manifest: it is ground truth for the recovery table
# and must be versioned alongside the results it scores.
!data/processed/overlay_manifest.json

.streamlit/secrets.toml
